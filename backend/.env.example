# Copy to .env to override. Every value below is the built-in default.

# Any SQLAlchemy URL. SQLite needs no infrastructure and is the default so a
# fresh checkout runs immediately; docker compose supplies the PostgreSQL URL.
DATABASE_URL=sqlite+pysqlite:///./accommodation.db
# DATABASE_URL=postgresql+psycopg://accommodation:accommodation@localhost:5432/accommodation

# Browser origins allowed to call the API, comma separated.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Create tables on startup. Turn off where migrations own the schema.
AUTO_CREATE_SCHEMA=true

# Log every statement SQLAlchemy emits.
SQL_ECHO=false

# Root log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
